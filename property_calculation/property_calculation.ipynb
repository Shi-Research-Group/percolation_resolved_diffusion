{
 "cells": [
  {
   "cell_type": "raw",
   "metadata": {},
   "source": [
    "---\n",
    "title: \"Pore-structure properties of a hyper-crosslinked polymer\"\n",
    "description: \"Pore graph and percolation analysis of 75X_0DVB_4 with mofography\"\n",
    "jupyter: python3\n",
    "---"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### This Jupyter notebook demonstrates how to compute pore-structure properties of a hyper-crosslinked polymer (HCP) with mofography. Using the 75X_0DVB_4 structure as an example, it builds a periodic pore graph and computes the largest cavity diameter, pore limiting diameter, N₂ accessible surface area, percolating pore volume, average pore and window sizes, pore connectivity, percolating backbone fraction, and fractional free volume.\n",
    "\n",
    "The structure is taken from https://doi.org/10.1021/acs.jctc.2c00798\n",
    "\n",
    "For detailed definitions of these properties, see our paper about methane diffusion: Zheng, C.; Gopalan, A.; Shi, K. Revisiting Percolation and Molecular Diffusion in Disordered Pore Networks (https://doi.org/10.26434/chemrxiv.15011012/v1).
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Requirements\n",
    "\n",
    "- python==3.11.9\n",
    "- mofography== 2026.10.9.1\n",
    "- numpy==1.23.5\n",
    "- pandas==2.2.2\n",
    "- ase==3.22.1\n",
    "- networkx==3.2.1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "os.environ[\"RAYON_NUM_THREADS\"] = \"8\"\n",
    "\n",
    "import pandas as pd\n",
    "import mofography as mgr\n",
    "from ase.io import read\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# TraPPE sigma (Å) of the united-atom sites in 75X_0DVB_4.cif\n",
    "trappe_dia = pd.Series(\n",
    "        {'C1': 4.65,\n",
    "         'C2': 3.95,\n",
    "         'C3': 3.88,\n",
    "         'C4': 3.695,\n",
    "         'C6': 4.65,\n",
    "         'C7': 3.95}\n",
    "        )\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "spacing = 0.5\n",
    "mask_thickness = 0.0\n",
    "h = 0.1\n",
    "threshold_abs = 0.3\n",
    "min_region_size = 0.00005\n",
    "preserve_threshold = 103.0\n",
    "smooth_threshold = 106.0\n",
    "max_smooth_radius = 2.0\n",
    "extra_padding = 2\n",
    "min_distance = 1.0\n",
    "minimum_window_separation = 1.5\n",
    "\n",
    "# probe radii (Å)\n",
    "probe_radius = 1.865      # CH4 (TraPPE sigma / 2), for percolation analysis\n",
    "n2_probe_radius = 1.82    # N2, for accessible surface area"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def add_volume_to_graph(graph, mat_atoms):\n",
    "\n",
    "    vol = mat_atoms.get_volume()\n",
    "    vol_L=vol/(1E27)\n",
    "    for i in graph.nodes():\n",
    "        graph.nodes[i]['cell_volume']=vol_L\n",
    "    return graph\n",
    "\n",
    "def add_pixel_ratio_to_graph(graph, regions_pbc):\n",
    "\n",
    "    n=regions_pbc.size\n",
    "    for i in graph.nodes():\n",
    "        pixel_counts = np.count_nonzero(regions_pbc == i)\n",
    "        graph.nodes[i]['pixel_counts']=pixel_counts\n",
    "        graph.nodes[i]['total_pixel_amounts']=n\n",
    "        graph.nodes[i]['pixel_ratio']=pixel_counts/n\n",
    "    return graph"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def add_connectivities_to_nodes(\n",
    "    graph,\n",
    "    probe_radius,\n",
    "    pore_radius_attr=\"pocket_radius\",\n",
    "    pixel_count_attr=\"pixel_counts\",\n",
    "    edge_radius_attr=\"window_radius\",\n",
    "):\n",
    "\n",
    "    for node in graph.nodes():\n",
    "\n",
    "        edges = {\n",
    "            (u, v, key): data\n",
    "            for u, v, key, data in (\n",
    "                list(graph.in_edges(node, keys=True, data=True))\n",
    "                + list(graph.out_edges(node, keys=True, data=True))\n",
    "            )\n",
    "        }\n",
    "\n",
    "        connectivity = len(edges)\n",
    "\n",
    "        if connectivity == 0:\n",
    "            continue\n",
    "\n",
    "        radii = np.array([\n",
    "            float(data[edge_radius_attr])\n",
    "            for data in edges.values()\n",
    "        ])\n",
    "\n",
    "        pore_radius = float(graph.nodes[node][pore_radius_attr])\n",
    "        pixel_count = float(graph.nodes[node][pixel_count_attr])\n",
    "\n",
    "        avg_radius = float(np.mean(radii))\n",
    "        min_radius = float(np.min(radii))\n",
    "\n",
    "        clearances = radii - probe_radius\n",
    "        avg_clearance = float(np.mean(clearances))\n",
    "\n",
    "        graph.nodes[node][\"connectivity\"] = connectivity\n",
    "        graph.nodes[node][\"pixel_count_times_connectivity\"] = pixel_count * connectivity\n",
    "        graph.nodes[node][\"avg_window_radius\"] = avg_radius\n",
    "        graph.nodes[node][\"avg_window_pore_ratio\"] = avg_radius / pore_radius\n",
    "        graph.nodes[node][\"avg_radius_times_connectivity\"] = connectivity * avg_radius\n",
    "        graph.nodes[node][\"min_window_radius\"] = min_radius\n",
    "        graph.nodes[node][\"min_radius_times_connectivity\"] = connectivity * min_radius\n",
    "        graph.nodes[node][\"avg_window_clearance\"] = avg_clearance\n",
    "        graph.nodes[node][\"clearance_times_connectivity\"] = connectivity * avg_clearance\n",
    "\n",
    "    return graph"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "mat_atoms = read('./75X_0DVB_4.cif',store_tags=True)\n",
    "site_labels = mat_atoms.info['_atom_site_label']\n",
    "radii = trappe_dia[site_labels].values/ 2.0\n",
    "dgrid = mgr.dgrid_from_atoms_rust(mat_atoms, spacing=spacing, radii=radii)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "results = mgr.do_periodic_segmentation_rust(\n",
    "                dgrid,\n",
    "                mat_atoms,\n",
    "                mask_thickness=mask_thickness,\n",
    "                h=h,\n",
    "                spacing=spacing,\n",
    "                return_dgrid=False,\n",
    "                threshold_abs=threshold_abs,\n",
    "                min_distance=min_distance,\n",
    "                return_padded_regions=True,\n",
    "                preserve_threshold=preserve_threshold,\n",
    "                smooth_threshold=smooth_threshold,\n",
    "                max_smooth_radius=max_smooth_radius,\n",
    "                extra_padding=extra_padding,\n",
    "                compute_connections=True,\n",
    "                min_region_size=min_region_size,\n",
    "                minimum_window_separation=minimum_window_separation,\n",
    "                watershed_backend=\"rust_det\",\n",
    "            )\n",
    "\n",
    "\n",
    "regions = results[\"regions\"]\n",
    "maxima_info = results[\"maxima_info\"]\n",
    "connections = results[\"connections\"]\n",
    "regions_pbc = results[\"regions_pbc\"]\n",
    "regions_1d = regions.flatten()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "**Pore graph.** Each node is a pore in the unit cell, and each edge is one window between two pores. Only windows between pores that own part of the original unit cell are kept, so every window is counted once. Windows that cross the cell boundary are kept as edges with a non-zero `relative_offset`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#construct pore graph\n",
    "graph=(mgr.make_directed_graph_from_segmentation_results_trimmed(results))\n",
    "\n",
    "graph = add_volume_to_graph(graph,mat_atoms)\n",
    "\n",
    "graph = add_pixel_ratio_to_graph(graph,regions_pbc)\n",
    "\n",
    "base_labels = (mgr.build_base_region_labels_from_results(results))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Largest cavity diameter (Å): diameter of the largest sphere that fits in the pore space, regardless of percolation\n",
    "lcd = dgrid.max() * 2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Pore limiting diameter (Å): diameter of the largest spherical probe that can pass through the periodic percolating pore network\n",
    "plr = mgr.find_pore_limiting_radius_winding(results,graph=graph,base_region_labels=base_labels,include_dangling=True)\n",
    "pld = plr * 2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# N2-accessible surface area (m²/g): surface area accessible to an N2-sized probe in the percolating pore network\n",
    "np.random.seed(0)\n",
    "n2_asa = (mgr.compute_surface_area_mc_winding(\n",
    "                    results,\n",
    "                    mat_atoms,\n",
    "                    probe_radius=n2_probe_radius,\n",
    "                    n_samples=50000,\n",
    "                    shell_thickness=1,\n",
    "                    return_details=False,\n",
    "                    window_fp=False,\n",
    "                    winding_kwargs=None,\n",
    "                )[\"accessible_surface_area\"]\n",
    "            )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Methane-accessible percolating pore network\n",
    "# before pruning: the whole percolating network, including self-loops and dangling branches\n",
    "# after pruning: only the shortest percolating backbone pathways\n",
    "percolation_pore_graph_before_pruning = (mgr.extract_percolating_pore_graph(graph,threshold=probe_radius,expand_components=True,include_dangling=True))\n",
    "percolation_pore_graph_before_pruning = (add_connectivities_to_nodes(percolation_pore_graph_before_pruning,probe_radius=probe_radius))\n",
    "\n",
    "percolation_pore_graph_after_pruning = (mgr.extract_percolating_pore_graph(graph,threshold=probe_radius,expand_components=False,include_dangling=False))\n",
    "percolation_pore_graph_after_pruning = (add_connectivities_to_nodes(percolation_pore_graph_after_pruning,probe_radius=probe_radius))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Percolating pore volume fraction: fraction of the cell volume occupied by the methane-accessible percolating pore network\n",
    "percolating_pore_volume_fraction=sum(percolation_pore_graph_before_pruning.nodes[node][\"pixel_ratio\"]for node in percolation_pore_graph_before_pruning.nodes())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Percolating gravimetric pore volume (cm³/g): percolating pore volume divided by the framework mass\n",
    "rho=0.82 # bulk density (g/cm³): framework mass / cell volume, from 10.1021/acs.jctc.2c00798\n",
    "percolating_gravimetric_pore_volume=percolating_pore_volume_fraction/rho"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Average percolating pore radius (Å): mean radius of the pores in the percolating network\n",
    "average_pore_radius = np.mean([percolation_pore_graph_before_pruning.nodes[n][\"pocket_radius\"] for n in percolation_pore_graph_before_pruning.nodes()])\n",
    "\n",
    "# Average accessible window radius (Å): for each pore, the mean radius of the accessible windows connected to it,\n",
    "# averaged over all pores in the percolating network\n",
    "average_accessible_window_radius = np.mean([percolation_pore_graph_before_pruning.nodes[n][\"avg_window_radius\"] for n in percolation_pore_graph_before_pruning.nodes()])\n",
    "\n",
    "# Average window-to-pore radius ratio: mean of (average radius of the windows connected to a pore / radius of that pore)\n",
    "w_to_p = np.mean([percolation_pore_graph_before_pruning.nodes[n][\"avg_window_radius\"] / percolation_pore_graph_before_pruning.nodes[n][\"pocket_radius\"] for n in percolation_pore_graph_before_pruning.nodes()])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Average pore connectivity: average number of accessible windows connected to each pore\n",
    "average_connectivity = np.mean([percolation_pore_graph_before_pruning.nodes[n][\"connectivity\"]for n in percolation_pore_graph_before_pruning.nodes()])\n",
    "\n",
    "# Average-window-radius-weighted connectivity = sum_i(c_i * r_w,i) / sum_i(r_w,i),\n",
    "# where c_i is the connectivity of pore i and r_w,i is the mean radius of its accessible windows\n",
    "average_window_size_weighted_connectivity = (sum(percolation_pore_graph_before_pruning.nodes[n][\"avg_radius_times_connectivity\"]for n in percolation_pore_graph_before_pruning.nodes())/sum(percolation_pore_graph_before_pruning.nodes[n][\"avg_window_radius\"]for n in percolation_pore_graph_before_pruning.nodes()))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Percolating backbone fraction = n_b / n_p: grid points in the shortest percolating backbone\n",
    "# divided by grid points in the whole percolating network\n",
    "percolating_pore_volume_fraction_backbone=sum(percolation_pore_graph_after_pruning.nodes[node][\"pixel_ratio\"]for node in percolation_pore_graph_after_pruning.nodes())\n",
    "fB=percolating_pore_volume_fraction_backbone/percolating_pore_volume_fraction"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fractional free volume = 1 - 1.3 * V_vdW / V_sp: fraction of the material volume not occupied by the framework\n",
    "Vvdw=np.sum(regions_1d==0)\n",
    "Vsp=len(regions_1d)\n",
    "ffv=1-1.3*(Vvdw/Vsp)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "metadata": {},
   "outputs": [
    {
